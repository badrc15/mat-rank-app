# Local defaults are safe for development; Node does not load this file automatically.
NODE_ENV=development
PORT=3000
# DATA_DIR should point at an existing database directory when migrating.
# On Fly: DATA_DIR=/data, NODE_ENV=production, APP_ORIGIN=https://bjj-elo-app.fly.dev
# Do not enable public registration until the launch checklist is complete.
SIGNUPS_ENABLED=false
# Email delivery must be configured and domain verification independently checked before enabling signup.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DOMAIN_VERIFIED=false
APP_ORIGIN=
# Stripe variables belong in the hosting provider's secret settings, never client code.
BILLING_ENABLED=false
BILLING_LAUNCH_READY=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
